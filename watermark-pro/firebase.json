{
  "database": {
    "rules": "database.rules.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      "functions/**",
      "functional-rnd.html",
      "admin-final.html",
      "user-final.html",
      "rnd-*.html",
      "dumpppppppppp.html",
      "system-store.js",
      "user-production.css",
      "user-production.js",
      "admin-production.css",
      "admin-production.js",
      "FIREBASE-SETUP.md",
      "_archive-not-for-upload/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}