{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false } },
    "adminProfiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid && root.child('admins').child(auth.uid).val() === true",
        "username": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20" },
        "avatarUrl": { ".validate": "newData.isString() && newData.val().length <= 2048" }
      }
    },
    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists())))",
        ".validate": "!newData.exists() || (newData.isString() && (newData.val() === auth.uid || root.child('admins').child(auth.uid).val() === true))"
      }
    },
    "publicProfiles": {
      ".read": true,
      ".indexOn": ["downloads"],
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['name','downloads','showOnTopUsers','censorUsername']) && newData.child('name').isString() && newData.child('downloads').isNumber() && newData.child('downloads').val() >= 0 && newData.child('showOnTopUsers').isBoolean() && newData.child('censorUsername').isBoolean()"
      }
    },
    "users": {
      ".indexOn": ["email", "name", "downloads"],
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists()))",
        "email": { ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && (!data.exists() || data.val() === '') && newData.val() === auth.token.email))", ".validate": "newData.isString() && (root.child('admins').child(auth.uid).val() === true || newData.val() === auth.token.email)" },
        "downloads": { ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)", ".validate": "newData.isNumber() && newData.val() >= 0" },
        "images": { ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)", ".validate": "newData.isNumber() && newData.val() >= 0" },
        "videos": { ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)", ".validate": "newData.isNumber() && newData.val() >= 0" },
        "showOnTopUsers": { ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)", ".validate": "newData.isBoolean()" },
        "censorUsername": { ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)", ".validate": "newData.isBoolean()" },
        "avatarUrl": { ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)", ".validate": "newData.isString() && newData.val().length <= 2048" },
        "accountCreatedAt": { ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && newData.isNumber() && (!data.exists() || newData.val() <= data.val())))", ".validate": "newData.isNumber() && newData.val() > 0" }
      }
    },
    "activities": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "$activityId": {
          ".write": "auth != null && ((!data.exists() && auth.uid === $uid) || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['createdAt','images','videos','total','watermarkType','font','position','color']) && newData.child('total').isNumber() && newData.child('total').val() > 0"
        }
      }
    },
    "subscriptions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists() && newData.child('status').val() === 'plain_free'))",
        "status": { ".validate": "newData.val() === 'plain_free' || newData.val() === 'expired_free' || newData.val() === 'pro'" }
      }
    },
    "payments": {
      ".indexOn": ["status", "uid", "submittedAt"],
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (query.orderByChild == 'uid' && query.equalTo == auth.uid))",
      "$paymentId": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending'))",
        "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'paid' || newData.val() === 'rejected'" }
      }
    },
    "settings": { ".read": true, ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" }
  }
}